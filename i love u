`index.html`<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cute Unicorn Love 💕</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Comic Sans MS', cursive;
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 50%, #fecfef 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .container {
            text-align: center;
            background: rgba(255, 255, 255, 0.9);
            padding: 40px;
            border-radius: 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            max-width: 500px;
            animation: bounceIn 1s ease-out;
        }

        @keyframes bounceIn {
            0% { transform: scale(0.3); opacity: 0; }
            50% { transform: scale(1.05); }
            70% { transform: scale(0.9); }
            100% { transform: scale(1); opacity: 1; }
        }

        .unicorn {
            width: 200px;
            height: 200px;
            margin: 0 auto 20px;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .unicorn:hover {
            transform: scale(1.1);
        }

        .question {
            font-size: 28px;
            color: #ff6b9d;
            margin-bottom: 30px;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }

        .buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 15px 30px;
            font-size: 20px;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            font-family: inherit;
            font-weight: bold;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .btn-yes {
            background: linear-gradient(45deg, #ff6b9d, #ff8e8e);
            color: white;
        }

        .btn-no {
            background: linear-gradient(45deg, #a8e6cf, #88d8a3);
            color: #333;
        }

        .btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

        .grow {
            animation: growBig 0.5s ease forwards;
        }

        @keyframes growBig {
            0% { transform: scale(1); }
            100% { transform: scale(1.5); }
        }

        .love-screen {
            display: none;
            animation: hearts 2s ease-out;
        }

        @keyframes hearts {
            0% { transform: scale(0); opacity: 0; }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        .love-message {
            font-size: 32px;
            color: #ff1493;
            margin: 20px 0;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }

        .hearts {
            font-size: 40px;
            animation: float 2s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        .flowers {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .flower {
            position: absolute;
            font-size: 30px;
            animation: flowerDance 3s ease-in-out infinite;
        }

        @keyframes flowerDance {
            0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.7; }
            25% { transform: translateY(-30px) rotate(90deg); opacity: 1; }
            50% { transform: translateY(-50px) rotate(180deg); opacity: 0.8; }
            75% { transform: translateY(-30px) rotate(270deg); opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="unicorn-screen">
            <img src="https://emojipedia-us.s3.dualstack.us-west-1.amazonaws.com/thumbs/120/apple/285/unicorn_1f984.png" 
                 alt="🦄 Cute Unicorn" class="unicorn" onclick="showQuestion()">
            <div class="question" id="question" style="display: none;">
                Do u love me Sam 🌹🤗?
            </div>
            <div class="buttons" id="buttons" style="display: none;">
                <button class="btn btn-yes" onclick="loveResponse()">Yes 💕</button>
                <button class="btn btn-no" id="noBtn" onclick="noResponse()">No 😢</button>
            </div>
        </div>

        <div class="love-screen" id="loveScreen">
            <div class="love-message">YAY Ghani also love u too 😋🥰</div>
            <div class="hearts">💖💕💗💖💕</div>
            <img src="https://emojipedia-us.s3.dualstack.us-west-1.amazonaws.com/thumbs/120/apple/285/unicorn_1f984.png" 
                 alt="🦄 Happy Unicorn" style="width: 150px; height: 150px;">
            <div style="font-size: 24px; margin-top: 20px;">💝💝💝</div>
        </div>

        <div class="flowers" id="flowers"></div>
    </div>

    <script>
        function showQuestion() {
            document.getElementById('question').style.display = 'block';
            document.getElementById('buttons').style.display = 'flex';
            document.querySelector('.unicorn').style.display = 'none';
        }

        function noResponse() {
            const noBtn = document.getElementById('noBtn');
            noBtn.classList.add('grow');
            
            // Make YES button even bigger and more attractive
            const yesBtn = document.querySelector('.btn-yes');
            yesBtn.style.transform = 'scale(1.3)';
            yesBtn.style.fontSize = '24px';
            yesBtn.innerHTML = 'YESSS 💖✨';
            
            // Shake the NO button away
            noBtn.style.animation = 'shake 0.5s ease-in-out';
        }

        function loveResponse() {
            // Hide question screen
            document.querySelector('.unicorn-screen').style.display = 'none';
            
            // Show love screen
            document.getElementById('loveScreen').style.display = 'block';
            
            // Create floating flowers
            createFlowers();
        }

        function createFlowers() {
            const flowersContainer = document.getElementById('flowers');
            const flowerTypes = ['🌸', '🌺', '🌹', '🌻', '🌷', '💐'];
            
            for (let i = 0; i < 20; i++) {
                const flower = document.createElement('div');
                flower.className = 'flower';
                flower.innerHTML = flowerTypes[Math.floor(Math.random() * flowerTypes.length)];
                flower.style.left = Math.random() * 100 + '%';
                flower.style.top = Math.random() * 100 + '%';
                flower.style.animationDelay = Math.random() * 3 + 's';
                flowersContainer.appendChild(flower);
            }
        }

        // Add shake animation for NO button
        const style = document.createElement('style');
        style.textContent = `
            @keyframes shake {
                0%, 100% { transform: translateX(0); }
                25% { transform: translateX(-10px); }
                75% { transform: translateX(10px); }
            }
        `;
        document.head.appendChild(style);
    </script>
</body>
</html>
